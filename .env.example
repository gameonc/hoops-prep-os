# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- RapidAPI (one key works for all RapidAPI-hosted APIs) ---
RAPIDAPI_KEY=YOUR-RAPIDAPI-KEY

# RapidAPI hosts (defaults set to what listing pages advertise; verify in your RapidAPI dashboard)
RAPIDAPI_HOST_EXERCISEDB=exercisedb.p.rapidapi.com
RAPIDAPI_HOST_AI_WORKOUT=ai-workout-planner-exercise-fitness-nutrition-guide.p.rapidapi.com
RAPIDAPI_HOST_MUSCLE_IMAGE=muscle-group-image-generator.p.rapidapi.com
RAPIDAPI_HOST_CALORIES=calories-burned-by-api-ninjas.p.rapidapi.com

# Air quality: choose one flavor.
#   iqair-direct   — bypass RapidAPI, use IQAir key at api.airvisual.com/v2 (recommended; free tier available)
#   airvisual1     — RapidAPI apidojo listing (host: airvisual1.p.rapidapi.com)
#   raygorodskij   — RapidAPI RPC-style listing (RPC methods, verify from your dashboard)
RAPIDAPI_AIRQUALITY_FLAVOR=iqair-direct
RAPIDAPI_HOST_AIRVISUAL=airvisual1.p.rapidapi.com
IQAIR_KEY=

# --- LLM for the planner agent (pick one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Wearables webhook (Health Auto Export iOS app) ---
# Shared secret the phone sends as X-OPENCLAW-TOKEN header.
# Keeps the same header name as the openclaw/trading-tools receiver so your
# phone shortcut doesn't need to change if you're migrating.
WEARABLES_WEBHOOK_TOKEN=change-me-to-a-long-random-string

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
